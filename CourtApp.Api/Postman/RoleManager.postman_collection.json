{
  "info": {
    "_postman_id": "rolemanager-collection",
    "name": "RoleManager API",
    "description": "Role management endpoints with CRUD operations and permission management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get All Roles (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager?pageNumber=1&pageSize=10&searchTerm=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager"
              ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "searchTerm",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Role by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager/role-id-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager",
                "role-id-here"
              ]
            }
          }
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Editor\",\n  \"description\": \"Editor role for content management\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager"
              ]
            }
          }
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"role-id-here\",\n  \"name\": \"Senior Editor\",\n  \"description\": \"Senior editor role\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager/role-id-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager",
                "role-id-here"
              ]
            }
          }
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager/role-id-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager",
                "role-id-here"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Role Permissions",
      "item": [
        {
          "name": "Get Role Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager/role-id-here/permissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager",
                "role-id-here",
                "permissions"
              ]
            }
          }
        },
        {
          "name": "Update Role Permissions (Activate/Deactivate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"permissionId\": \"CREATE_CASE\",\n    \"isActive\": true\n  },\n  {\n    \"permissionId\": \"EDIT_CASE\",\n    \"isActive\": true\n  },\n  {\n    \"permissionId\": \"DELETE_CASE\",\n    \"isActive\": false\n  },\n  {\n    \"permissionId\": \"VIEW_REPORTS\",\n    \"isActive\": true\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rolemanager/role-id-here/permissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rolemanager",
                "role-id-here",
                "permissions"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ]
}
