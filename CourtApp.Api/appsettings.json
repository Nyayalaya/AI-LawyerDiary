{
  "UseInMemoryDatabase": false,
  "DatabaseProvider": "Postgres",

  "ConnectionStrings": {
    "Postgres": "CONFIGURE_DATABASE_CONNECTION_STRING",
    "SqlServer": "CONFIGURE_DATABASE_CONNECTION_STRING"
  },

  "JWTSettings": {
    "Key": "your-secret-key-minimum-32-characters-long-change-in-production",
    "Issuer": "CourtApp",
    "Audience": "CourtAppUsers",
    "DurationInMinutes": 60
  },

  "MailSettings": {
    "From": "applawyerdiary@gmail.com",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "applawyerdiary@gmail.com",
    "Password": "kmgp spfo tsph gtoi",
    "DisplayName": "Dushyant Singh",
    "EnableSsl": true
  },

  "WhatsAppSettings": {
    "ApiUrl": "https://waba.360dialog.io/v1/messages",
    "ApiKey": "YOUR_API_KEY"
  },

  "UploadSettings": {
    "Provider": "GoogleDrive",
    "Folders": {
      "ProfileImages": "profile-images",
      "DraftDocuments": "draft-documents",
      "OrderDocuments": "order-documents"
    },
    "AzureBlob": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "BaseUrl": "http://127.0.0.1:10000/devstoreaccount1",
      "ContainerName": "documents"
    },
    "GoogleDrive": {
      "ServiceAccountKeyFilePath": "service-account-key.json",
      "BaseFolderId": "1ZtuqfP89zQSW1exL6HUQFQ4AAbwGpAty",
      "ApplicationName": "LawyerDiary",
      "DownloadBaseUri": "https://drive.google.com/uc?export=download&id="
    },
    "Local": {
      "RootPath": "UploadedFiles"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "Logs/api-log-{Date}.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "CourtApp.Api",
      "Environment": "Development"
    }
  },

  "AI": {
    "Provider": {
      "CurrentProvider": "Gemini",
      "FallbackProvider": "OpenAI",
      "AllowProviderFallback": true
    },

    "General": {
      "EnableStreaming": true,
      "EnableCaching": true,
      "EnableLogging": true,
      "EnableRetry": true,
      "EnableFunctionCalling": true,
      "EnableTelemetry": true,
      "EnablePromptLogging": false,
      "EnableResponseLogging": false,
      "EnableTokenTracking": true,
      "EnableCostTracking": true,
      "DefaultTemperature": 0.3,
      "DefaultMaxTokens": 1024,
      "MaxConversationMessages": 5
    },

    "Gemini": {
      "ApiKey": "#{GEMINI_API_KEY}#",
      "Endpoint": "https://generativelanguage.googleapis.com",
      "Model": "gemini-2.5-flash",
      "EmbeddingModel": "text-embedding-004",
      "VisionModel": "001",
      "Temperature": 1,
      "TopP": 0.95,
      "TopK": 40,
      "CandidateCount": 1,
      "MaxOutputTokens": 1024,
      "EnableStreaming": true,
      "EnableThinking": true,
      "EnableGrounding": false
    },

    "Retry": {
      "MaxRetryCount": 3,
      "RetryDelay": 2,
      "EnableExponentialBackoff": true,
      "EnableCircuitBreaker": true,
      "CircuitBreakerFailures": 5,
      "CircuitBreakerDurationSeconds": 30
    },

    "HttpClient": {
      "TimeoutSeconds": 120,
      "MaxConnectionsPerServer": 20,
      "EnableCompression": true
    },

    "Timeout": {
      "ChatTimeoutSeconds": 120,
      "EmbeddingTimeoutSeconds": 60,
      "ImageTimeoutSeconds": 180
    },

    "FeatureFlags": {
      "EnableChat": true,
      "EnablePlugins": true,
      "EnableAgents": false,
      "EnableEmbedding": false,
      "EnableRag": false,
      "EnableVision": false
    },

    "Kernel": {
      "AutoInvokeFunctions": true,
      "EnablePlanning": false,
      "EnableMemory": true,
      "EnableStreaming": true,
      "MaxFunctions": 20
    },

    "Logging": {
      "LogPrompt": false,
      "LogResponse": false,
      "LogExecutionTime": true,
      "LogTokenUsage": true,
      "LogCost": true,
      "LogErrors": true
    }
  },
  "AllowedHosts": "*",
  "ApiVersion": "1.0"
}
